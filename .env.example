# Copy to `.env.local` (never commit real keys) — or create `.env.local` next to this file.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional — leave unset to auto-try current models (see geminiGenerate.ts).
# In AI Studio, open a model and copy its exact API id if auto-selection fails.
# GEMINI_MODEL=gemini-2.5-flash

# Optional — arrange step max output tokens (default 32768, capped at 65536). Increase if long songs return cut-off JSON.
# GEMINI_MAX_OUTPUT_TOKENS=65536
